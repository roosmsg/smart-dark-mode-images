{
  "name": "obsidian-dark-mode-images",
  "version": "0.1.0",
  "description": "Automatically adapts images for Obsidian dark mode while leaving already-dark images uninverted.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dark-mode",
    "images"
  ],
  "author": "Djinx",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0"
  }
}
